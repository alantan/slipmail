{
  "license": "MIT",
  "nodeModulesDir": "none",
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.13",
    "@std/path": "jsr:@std/path@1.1.1",
    "postal-mime": "npm:postal-mime@2.4.3"
  },
  "tasks": {
    "check": "deno check src scripts tests",
    "lint": "deno lint && deno fmt --check",
    "test": "deno test --allow-net=127.0.0.1 --allow-run=openssl --allow-read --allow-write --allow-env tests",
    "build": "deno run --allow-read --allow-write=dist --allow-run=deno --allow-env scripts/build.ts",
    "security-check": "deno run --allow-read --allow-run=deno scripts/security_check.ts"
  },
  "fmt": { "lineWidth": 110, "exclude": ["dist"] },
  "lint": { "exclude": ["dist"] }
}
